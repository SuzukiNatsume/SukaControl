<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <AssemblyName>SukaControl</AssemblyName>
    <RootNamespace>SukaControl</RootNamespace>
    <ApplicationIcon>Assets\MiControl.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Core.cs;Native.cs;Lighting.cs;LightingSession.cs;HardwareService.cs;KeyService.cs;SessionAgent.cs;UserSession.cs;Language.cs" />
    <ProjectReference Include="..\Suka.Core\Suka.Core.csproj" />
    <Resource Include="Assets\*.ico" />
    <Content Include="Licenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Content Include="Profiles\xiaomi_*.icc" Link="Profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>
